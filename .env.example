# Human-readable application name
APP_NAME=LangChain RAG Application

# Use development while running the application locally.
APP_ENV=development 

# FastAPI local server settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Address used by the Streamlit frontend to call FastAPI
BACKEND_URL=http://127.0.0.1:8000

# Local SQLite database location
DATABASE_URL=sqlite:///./rag_app.db